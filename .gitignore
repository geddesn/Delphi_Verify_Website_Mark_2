# Dependencies
node_modules/

# Build output — regenerated by `npm run build`
dist/
dist-ssr/
dist-pdf/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Image masters
# ---------------------------------------------------------------------------
# The generated PNG masters in assets-src/ are 5–7 MB each and total ~120 MB.
# They are NOT committed. What is committed instead:
#
#   • assets-src/**/*.prompt.txt  — the real provenance. Each carries the
#     model, aspect ratio, Runway task ID and the full brief, so any master
#     can be regenerated with `npm run generate-image`.
#   • public/assets/**/*.webp     — the optimised images the site actually
#     serves, produced from the masters by `npm run images`.
#
# Keep the masters in the shared Assets folder alongside the app screenshots.
# For a company selling provenance, the prompt is the image's provenance —
# never add a master without its .prompt.txt beside it.
assets-src/**/*.png
assets-src/**/*.jpg
assets-src/**/*.jpeg
assets-src/**/*.webp

# Capture output. scripts/capture-trust.mjs records the trust stage to a GIF or
# a WebM; both are tens of megabytes and both are regenerable with
# `npm run capture`, so neither belongs in git.
trust-engine.gif
trust-engine.webm

# Playwright MCP scratch — snapshots and console logs from browser sessions
.playwright-mcp/

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local env — API keys live in the user environment, never in the repo
.env
.env.*
!.env.example
