{
  "name": "delphi-verify-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:tokens && tsc -b && npm run build:client && npm run build:ssr && npm run prerender",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:tokens": "node scripts/check-tokens.mjs",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "images": "node scripts/optimise-images.mjs",
    "ground": "node scripts/render-ground.mjs",
    "capture": "node scripts/capture-trust.mjs",
    "pdf": "node scripts/pdf.mjs",
    "og": "node scripts/generate-og.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "ffmpeg-static": "^5.3.0",
    "gifenc": "^1.0.3",
    "oxlint": "^1.75.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
